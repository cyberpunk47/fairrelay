# PostgreSQL credentials and database name
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# PostgreSQL connection string (postgres is the Docker service hostname)
DATABASE_URL=

# FairRelay API server listening address
HTTP_ADDR=:8080

# Producer authentication (sent as the X-API-Key header)
PRODUCER_API_KEY=

# Scheduling policy: fifo | roundrobin | drr
POLICY=drr

# Delivery goroutines per dispatcher process
WORKERS=200

# Lease duration before an abandoned delivery can be reclaimed
LEASE_TTL=30s

# Connection establishment and overall HTTP request timeouts
CONNECT_TIMEOUT=2s
REQUEST_TIMEOUT=10s

# Delivery retry limits and exponential backoff boundaries
MAX_ATTEMPTS=8
BACKOFF_BASE=1s
BACKOFF_MAX=10m

# Circuit breaker: open after this many failures in a row, try one probe after the cooldown
BREAKER_FAILURES=5
BREAKER_COOLDOWN=30s
