# PostgreSQL credentials and database name
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# PostgreSQL connection string (postgres is the Docker service hostname)
DATABASE_URL=

# FairRelay API server listening address
HTTP_ADDR=:8080

# Producer authentication and payload signing secrets
PRODUCER_API_KEY=
SIGNING_SECRET=

# Scheduling policy: Deficit Round Robin for tenant fairness
POLICY=drr

# Concurrent worker pool sizes for fast and slow deliveries
WORKERS_FAST=150
WORKERS_SLOW=50

# Maximum simultaneous in-flight deliveries allowed per tenant
TENANT_MAX_INFLIGHT=2

# Lease duration before an abandoned delivery can be reclaimed
LEASE_TTL=30s

# Connection establishment and overall HTTP request timeouts
CONNECT_TIMEOUT=2s
REQUEST_TIMEOUT=10s

# Delivery retry limits and exponential backoff boundaries
MAX_ATTEMPTS=8
BACKOFF_BASE=1s
BACKOFF_MAX=10min

# Circuit breaker failure threshold and recovery cooldown
BREAKER_FAILURE=5
BREAKER_COOLDOWN=30s

# Receiver HTTP server listening address
RECEIVER_ADDR=:9000